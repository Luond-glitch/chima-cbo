# Copy to .env and fill in. NEVER commit .env.
PORT=3001
NODE_ENV=development

# All form submissions are delivered here:
MAIL_TO=info@chima.org

# SMTP login of the mailbox that SENDS the notifications (usually info@chima.org itself).
# Ask your email/hosting provider for these. Examples:
#   Google Workspace: smtp.gmail.com, port 587, user = the mailbox, pass = an "App password"
#   cPanel hosting:   mail.yourdomain.com, port 465 (SMTP_SECURE=true) or 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@chima.org
SMTP_PASS=
# Optional: MAIL_FROM="CHIMA Website" <info@chima.org>
